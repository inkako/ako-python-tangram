# ====================================
# Environment Configuration
# ====================================
# local development stage production
ENV=local

# ====================================
# Application Configuration
# ====================================
DEBUG=false
APP_NAME="AKO PYTHON TANGRAM"
APP_DESC="A TANGRAM PROJECT"

# ====================================
# Logging Configuration
# ====================================
LOG_LEVEL=INFO
LOG_FORMAT=standard
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=false
LOG_FILE_PATH="logs/app.log"
LOG_FILE_MAX_SIZE=104857600
LOG_FILE_BACKUP_COUNT=10

# ====================================
# Web Server Configuration
# ====================================
# CORS settings
CORS_ENABLE=true
CORS_ALLOW_ORIGINS="localhost,127.0.0.1"
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Compression settings
GZIP_ENABLED=true
GZIP_MINIMUM_SIZE=1024

# ====================================
# Authentication Configuration
# ====================================
SECRET_KEY=XXXXX
# Session
SESSION_TIMEOUT_MINUTES=30
# CSRF Protection
CSRF_PROTECTION_ENABLED=false

# ====================================
# Database Configuration(async)
# ====================================
# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PREFIX=postgres+asyncpg://
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=2
